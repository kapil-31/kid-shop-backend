// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  fullName     String?
  password     String
  role         Role           @default(CUSTOMER)
  createdAt    DateTime       @default(now())
  avatar       String?
  refreshToken RefreshToken[]
  orders       Order[]
  cart         Cart?
  address      Address[]

}

model Product {
  id          String         @id @default(uuid())
  name        String
  price       Decimal
  description String
  isActive    Boolean        @default(true)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stockQty    Int
  images      ProductImage[]
  tags        String?
  reviews     Review[]
  orderItems  OrderItem[]
  cartItem    CartItems[]
  createdAt   DateTime       @default(now())
  updateAt    DateTime       @default(now())
}

model ProductImage {
  id        String      @id @default(cuid())
  url       String
  urlThumb  String?
  altText   String?
  name      String
  size      Decimal
  order     Int         @default(0)
  productId String
  status    ImageStatus @default(PENDING)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updateAt  DateTime    @default(now())

  @@index([productId])
}

enum ImageStatus {
  COMPLETED
  PENDING
  PROCESSING
  FAILED
}

model Review {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  rating             Int
  content            String
  isVerifiedPurchase Boolean  @default(true)
  createdAT          DateTime @default(now())
  updatedAT          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  logo        Json?
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updateAt    DateTime  @default(now())
  product     Product[]
}

model Order {
  id                String         @id @default(uuid())
  userId            String
  status            OrderStatus    @default(PENDING)
  note              String?
  subTotal          Decimal
  discountTotal     Decimal
  taxTotal          Decimal
  shippingTotal     Decimal
  grandTotal        Decimal
  currency          String
  shippingAddressId String
  billingAddressId  String
  placedAt          DateTime?
  total             Decimal
  user              User           @relation(fields: [userId], references: [id])
  createdAt         DateTime       @default(now())
  orderItems        OrderItem[]
  address           OrderAddress[]
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal
  discountAmount Decimal
  line_total     Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Cart {
  id        String      @id @default(uuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAT DateTime    @default(now())
  items     CartItems[]
}

model Address {
  id                String   @id @default(uuid())
  userId            String
  fullName          String
  line1             String?
  line2             String?
  city              String
  state             String
  postalCode        String
  phone             String
  country           String
  isDefaultBilling  Boolean  @default(true)
  isDefaultShipping Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
}

model OrderAddress {
  id            String          @id @default(uuid())
  orderId       String
  addressId     String
  type          OrderAdressType @default(SHIPPING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  fullName      String
  line1         String?
  line2         String?
  city          String
  state         String
  postalCode    String
  phone         String
  country       String
  order         Order           @relation(fields: [orderId], references: [id])
  snapshottedAt DateTime        @default(now())
}

model CartItems {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String
  quantity  Int
  unitPrice Int
  lineTotal Int
  createdAt DateTime @default(now())
  updatedAT DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  type              CouponType         @default(PERCENT)
  value             Decimal
  maxDiscount       Decimal?
  minOrderAmount    Decimal?
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  startAt           DateTime?
  endAt             DateTime?
  isActive          Boolean            @default(false)
  redeems           CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  userId          String
  orderId         String
  discountApplied Decimal
  redeemedAt      DateTime
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
}

enum Role {
  ADMIN
  CUSTOMER
}

enum CouponType {
  FIXED
  PERCENT
  FREE_SHIPPING
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  REFUNDED
  CANCELLED
}

enum OrderAdressType {
  BILLING
  SHIPPING
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TempUpload {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  tempPath     String
  size         Int
  mimetype     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

